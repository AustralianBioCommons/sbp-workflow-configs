plugins {
    id 'nf-gadi@1.3.1'
    id 'nf-schema@2.1.1'
}

gadi {
    format = 'csv'
    output = "report_${new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')}.csv"
    publishTo =  { "${params.outdir}/UsageReport.csv" }
}

params {
    config_profile_name         = 'Run profile - SBP'
    config_profile_description  = 'Running configuration for SBP platform production usage'
    use_dgxa100 = false
    project = 'yz52'
}

singularity {
    runOptions = '--nv'
    cacheDir   = '/g/data/if89/singularity_cache/'
}

executor {
    queueSize = 300
}

env.OPENMM_PLATFORM_ORDER="CPU"
env.OPENMM_DEFAULT_PLATFORM="CPU"

process {
   // clusterOptions will be overridden by backend
   executor = 'pbspro'
   storage = 'gdata/if89+gdata/li87+gdata/yz52'
   module = 'singularity'
   cache = 'lenient'
   stageInMode = 'symlink'
   queue = { task.memory < 128.GB ? 'normalbw' : (task.memory >= 128.GB && task.memory <= 190.GB ? 'normal' : (task.memory > 190.GB && task.memory <= 1020.GB ? 'hugemembw' : '')) }

   errorStrategy = {
      def transientSignal = task.exitStatus in ((130..145) + [104, 175])
      def errLog = task.workDir.resolve('.command.err')
      def transientIO = errLog.exists() && (errLog.text.contains('BrokenPipeError'))
      (transientSignal || transientIO) ? 'retry' : 'finish'
   }
   maxRetries = 1
   maxErrors  = '-1'

   withName: 'BINDCRAFT' {
      queue         = { params.use_dgxa100 ? 'dgxa100' : 'gpuvolta' }
      cpus          = { params.use_dgxa100 ? 16 : 12 }
      gpus          = 1
      memory        = '24.GB'
      time          = '24.h'
      errorStrategy = 'terminate'
   }
}

tower {
    enabled  = true
    endpoint = 'https://seqera.services.biocommons.org.au/api'
}
