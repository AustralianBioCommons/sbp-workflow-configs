// SBP Gadi configuration for nf-core/proteinfold

// NCI Gadi nf-core configuration profile
plugins {
    id 'nf-schema@2.7.2'
    id 'nf-gadi@1.4.0'
}

gadi {
    format = 'csv'
    output = "report_${new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')}.csv"
    publishTo =  { "${params.outdir}/UsageReport.csv" }
}

// SBP required parameters; these are populated at runtime by the BioCommons service layer
params {
    alphafold2_db                   = "${System.getenv('PF_DB_BASE_DIR')}/"
    alphafold2_bfd_path             = "${System.getenv('PF_DB_BASE_DIR')}/bfd/*"
    alphafold2_small_bfd_path       = "${System.getenv('PF_DB_BASE_DIR')}/small_bfd/*"
    alphafold2_params_path          = "${System.getenv('PF_DB_BASE_DIR')}/params/alphafold_params_2022-12-06/*"
    alphafold2_mgnify_path          = "${System.getenv('PF_DB_BASE_DIR')}/mgnify/*"
    alphafold2_pdb70_path           = "${System.getenv('PF_DB_BASE_DIR')}/pdb70/**"
    alphafold2_pdb_mmcif_path       = "${System.getenv('PF_DB_BASE_DIR')}/pdb_mmcif/mmcif_files"
    alphafold2_pdb_obsolete_path    = "${System.getenv('PF_DB_BASE_DIR')}/pdb_mmcif/obsolete.dat"
    alphafold2_uniref30_path        = "${System.getenv('PF_DB_BASE_DIR')}/uniref30/*"
    alphafold2_uniref90_path        = "${System.getenv('PF_DB_BASE_DIR')}/uniref90/*"
    alphafold2_pdb_seqres_path      = "${System.getenv('PF_DB_BASE_DIR')}/pdb_seqres/*"
    alphafold2_uniprot_path         = "${System.getenv('PF_DB_BASE_DIR')}/uniprot/*"

    colabfold_db                        = "${System.getenv('PF_DB_BASE_DIR')}/"
    colabfold_envdb_path                = "${System.getenv('PF_DB_BASE_DIR')}/colabfold_envdb/*"
    colabfold_uniref30_path             = "${System.getenv('PF_DB_BASE_DIR')}/colabfold_uniref30/*"
    colabfold_alphafold2_params_path    = "${System.getenv('PF_DB_BASE_DIR')}/params/alphafold_params_2022-12-06"

    boltz_db            = "${System.getenv('PF_DB_BASE_DIR')}/"
    boltz_ccd_path      = "${System.getenv('PF_DB_BASE_DIR')}/params/ccd.pkl"
    boltz_model_path    = "${System.getenv('PF_DB_BASE_DIR')}/params/boltz1_conf.ckpt"
    boltz2_aff_path     = "${System.getenv('PF_DB_BASE_DIR')}/params/boltz2_aff.ckpt"
    boltz2_conf_path    = "${System.getenv('PF_DB_BASE_DIR')}/params/boltz2_conf.ckpt"
    boltz2_mols_path    = "${System.getenv('PF_DB_BASE_DIR')}/params/mols/"

    use_gpu = true
    skip_multiqc = true
}

process {
    executor     = 'pbspro'
    // clusterOptions would be filled from backend
    storage      = 'gdata/if89+gdata/li87+gdata/yz52+scratch/yz52'
    module       = 'singularity'
    cache        = 'lenient'
    stageInMode  = 'symlink'
    beforeScript = 'module load singularity'
    scratch       = true
    disk          = 20.GB

    // NOTE: base.config uses (175..177); this config only retries on 175 and BrokenPipeError
    errorStrategy = {
        def transientSignal = task.exitStatus in ((130..145) + [104, 175])
        def errLog = task.workDir.resolve('.command.err')
        def errText = errLog.exists() ? errLog.text : ''
        def transientIO = errText.contains('BrokenPipeError')
        // Singularity can fail transiently while attaching the image to a loop device.
        def transientContainerCreation = task.exitStatus == 255 &&
            errText.contains('container creation failed')
        (transientSignal || transientIO || transientContainerCreation) ? 'retry' : 'finish'
    }
    maxRetries = 1
    maxErrors  = '-1'

    queue = {
        task.memory < 128.GB   ? 'normalbw' :
        task.memory <= 190.GB  ? 'normal'   :
        task.memory <= 1020.GB ? 'hugemembw' : ''
    }

   withName: 'RUN_ALPHAFOLD2_PRED|RUN_ALPHAFOLD2|COLABFOLD_BATCH' {
      queue       = "gpuhopper"
      cpus        = 12
      gpus        = 1
      disk        = 100.GB
      time        = 6.h
      memory      = 256.GB
      maxForks    = 2
   }

   withName: 'COLABFOLD_BATCH' {
      queue       = "gpuhopper"
      cpus        = 12
      gpus        = 1
      time        = 6.h
      memory      = 256.GB
      maxForks    = 2
      // Overwriting here to disable amber etc
      ext.args    = {[
        params.random_seed != null      ? "--random-seed ${params.random_seed}" : '',
      ].findAll { arg -> arg }.join(' ').trim()}
   }

   withName: 'RUN_BOLTZ' {
      queue       = "gpuhopper"
      cpus        = 12
      gpus        = 1
      time        = 6.h
      memory      = 256.GB
      maxForks    = 2
      // Extra jobfs for the boltz mols directory symlinked as input
      disk        = 100.GB
      // LMI4boltz customisation
      container = '/g/data/if89/singularity_cache/proteinfold_boltz_lmi_1.3.0.sif'
      ext.args = {[
        params.boltz_model          ? "--model ${params.boltz_model}"             : "",
        params.random_seed != null  ? "--seed ${params.random_seed}"              : "",
        params.use_msa_server       ? "--use_msa_server"                          : "",
        params.msa_server_url       ? "--msa_server_url ${params.msa_server_url}" : "",
        params.boltz_use_potentials ? "--use_potentials"                          : "",
        params.boltz_use_kernels    ? ""                                          : "--no_kernels",
        "--write_full_pae",
        "--chunk_size_transition_z 32",
        "--chunk_size_tri_attn 64",
      ].findAll { arg -> arg }.join(' ').trim() }
   }

   withName: 'RUN_ALPHAFOLD2_MSA' {
      queue   = 'normalbw'
      cpus    = 18
      time    = 10.h
      memory  = 72.GB
      disk    = 100.GB
   }

   withName: 'MMSEQS_COLABFOLDSEARCH' {
      queue   = 'normalbw'
      // cpus is used to set the number of threads for colabfold search
      cpus    = 14
      time    = 8.h
      scratch = false

      ext {
        args = '--db-load-mode 2 --db1 /iointensive/colabfold_uniref30/uniref30_2302_db --db3 /iointensive/colabfold_envdb/colabfold_envdb_202108_db'
      }
      
      // TODO: clusterOptions needs to sync in backend. All -l options needs to be included in clusterOptions.
      // Request 2TB iointensive storage to store the colabfold dbs (1.4TB) for speed up processing
      // ncpus, mem, and storage must be specified in clusterOptions; otherwise, they will be ignored. (Only for this process)
      clusterOptions = "-l iointensive=2,ncpus=14,mem=128GB,storage=gdata/if89+gdata/li87+gdata/yz52+scratch/yz52"

      // TODO: index files are temporarily stored in scratch
      beforeScript = "cp -r /scratch/yz52/wxx900/database/colabfold /iointensive/"
   }

   withName: 'MMCIF2PDB|FASTA2JSON|FASTA2YAML|MULTIQC|MULTIFASTA_TO_CSV' {
      queue  = 'normalbw'
      maxRetries = 3
      memory = { 4.GB * task.attempt }
      cpus   = 1
      time   = 20.m
   }

   withName: 'GENERATE_REPORT' {
      errorStrategy = {
        def errLog = task.workDir.resolve('.command.err')
        def errText = errLog.exists() ? errLog.text : ''

        def retryable =
            task.exitStatus in ((130..145) + [104, 175]) ||
            errText.contains('BrokenPipeError') ||
            (
                task.exitStatus == 255 &&
                errText.contains('container creation failed')
            ) ||
            (
                task.exitStatus == 1 &&
                (
                    errText.contains('Cannot allocate memory') ||
                    errText.contains('Killed')
                )
            )

        retryable ? 'retry' : 'finish'
      }
      queue      = 'normalbw'
      cpus       = 1
      maxRetries = 3
      memory     = { 10.GB * task.attempt }
      time       = { 20.m * task.attempt }
    }
}

singularity {
    runOptions = ''
    cacheDir   = '/g/data/if89/singularity_cache/'
}

executor {
    queueSize         = 300
    pollInterval      = 5.m
    queueStatInterval = 5.m
    submitRateLimit   = '20 min'
}

tower {
    enabled = true
    endpoint = 'https://seqera.services.biocommons.org.au/api'
}
